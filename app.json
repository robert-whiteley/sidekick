{
  "expo": {
    "name": "Sidekick",
    "slug": "sidekick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ondevice.sidekick",
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.ondevice.sidekick",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.READ_CALL_LOG"
      ],
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM", "android.permission.CALL_PHONE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.3.21",
            "extraMavenRepos": ["https://jitpack.io"]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sidekick uses the camera to answer questions about what you are looking at. Photos stay on this phone.",
          "microphonePermission": "Sidekick listens for your questions. Audio stays on this phone.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Sidekick reads your contacts to answer \"what's Sam's number\" and to name voices. Contacts stay on this phone."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Sidekick reads your calendar to answer questions like \"when is my dentist\", and adds events only after you tap Add. Events stay on this phone."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "./plugins/without-firebase-messaging",
      "./plugins/with-usb-camera",
      "./plugins/with-share-target",
      "expo-video",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "scheme": "sidekick",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "google": {
        "androidClientId": "589193178601-soll8g1g6m3krjvcidu3jnl57f69kjfp.apps.googleusercontent.com"
      },
      "support": {
        "email": "info@sashy.ai"
      },
      "eas": {
        "projectId": "9e5e57c2-26e2-4ca4-9191-3606924369f5"
      }
    },
    "owner": "rcwhiteley1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9e5e57c2-26e2-4ca4-9191-3606924369f5",
      "checkAutomatically": "NEVER"
    }
  }
}
