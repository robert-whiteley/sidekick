<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Offline place names for memories, and auto-pause at places you choose. Optional. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <application>
    <!-- GPU backend: vendor OpenCL, optional so phones without it still install. -->
    <uses-native-library android:name="libOpenCL.so" android:required="false" />
    <!-- Pixels expose OpenCL only under this name (see /vendor/etc/public.libraries.txt). -->
    <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
    <uses-native-library android:name="libvndksupport.so" android:required="false" />
    <!-- Background listening (wake word + transcripts); started only while the app is visible. -->
    <service
      android:name="dev.sidekick.engine.ListenService"
      android:exported="false"
      android:foregroundServiceType="microphone|location" />
  </application>
</manifest>
