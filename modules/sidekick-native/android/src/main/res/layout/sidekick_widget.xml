<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/sidekick_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="6dp">

  <Button
    android:id="@+id/sidekick_widget_ask"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="6dp"
    android:layout_weight="1"
    android:background="@drawable/sidekick_widget_button"
    android:text="@string/sidekick_widget_ask"
    android:textAllCaps="false"
    android:textColor="#FFFFFF"
    android:textSize="16sp" />

  <Button
    android:id="@+id/sidekick_widget_capture"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/sidekick_widget_button_dark"
    android:text="@string/sidekick_widget_capture"
    android:textAllCaps="false"
    android:textColor="#FFFFFF"
    android:textSize="16sp" />
</LinearLayout>
