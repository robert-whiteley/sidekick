{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "autoMemoryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "timeout 15 git fetch -q origin 2>/dev/null; git merge --ff-only -q origin/main 2>/dev/null; true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude-guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
