      "<rootDir>/.claude/"
    ]
  },
  "license": "Apache-2.0",
  "op-sqlite": {
    "sqlcipher": true,
    "sqliteVec": true,
    "fts5": true,
    "performanceMode": true
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-location",
          "expo-sensors"
        ]
      }
    }
